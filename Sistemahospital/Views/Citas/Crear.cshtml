@{
    ViewBag.Title = "Nueva Cita";
}

<div class="page-header">
    <h4><i class="fas fa-calendar-plus"></i> Registrar Nueva Cita</h4>
    <small><a href="@Url.Action("Index")">Citas</a> / Nueva</small>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card" style="max-width:700px;">
    <div class="card-body">
        @using (Html.BeginForm("Crear", "Citas", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Paciente</label>
                    <select name="idPaciente" class="form-select" required>
                        <option value="">Seleccione...</option>
                        @foreach (var p in ViewBag.Pacientes)
                        {
                            <option value="@p.IDPaciente">@p.Nombre @p.Apellido</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Medico</label>
                    <select name="idMedico" class="form-select" required>
                        <option value="">Seleccione...</option>
                        @foreach (var m in ViewBag.Medicos)
                        {
                            <option value="@m.IDMedico">@m.Nombre @m.Apellido - @m.Especialidad</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Hospital</label>
                    @if (ViewBag.IDHospitalFijo != null)
                    {
                        <input type="hidden" name="idHospital" value="@ViewBag.IDHospitalFijo" />
                        <input type="text" class="form-control" disabled
                               value="@(ViewBag.IDHospitalFijo == 1 ? "Hospital Central San Jose" : "Hospital Metropolitano")" />
                    }
                    else
                    {
                        <select name="idHospital" class="form-select">
                            <option value="1">Hospital Central San Jose</option>
                            <option value="2">Hospital Metropolitano</option>
                        </select>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha y Hora</label>
                    <input type="datetime-local" name="fechaHora" class="form-control" step="1800" required />
                    <small class="text-muted">Cupos cada 30 minutos, de 7:00 a.m. a 5:00 p.m.</small>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
            </div>
        }
    </div>
</div>