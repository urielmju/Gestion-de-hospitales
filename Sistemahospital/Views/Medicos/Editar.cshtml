@model Sistemahospital.Models.Medico
@{
    ViewBag.Title = "Editar Medico";
}

<div class="page-header">
    <h4><i class="fas fa-user-edit"></i> Editar Medico</h4>
    <small><a href="@Url.Action("Index")">Medicos</a> / Editar</small>
</div>

<div class="card" style="max-width:700px;">
    <div class="card-body">
        @using (Html.BeginForm("Editar", "Medicos", FormMethod.Post))
        {
            <input type="hidden" name="IDMedico" value="@Model.IDMedico" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input type="text" name="Nombre" value="@Model.Nombre" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Apellido</label>
                    <input type="text" name="Apellido" value="@Model.Apellido" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Especialidad</label>
                    <input type="text" name="Especialidad" value="@Model.Especialidad" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Telefono</label>
                    <input type="text" name="Telefono" value="@Model.Telefono" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input type="email" name="Email" value="@Model.Email" class="form-control" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
            </div>
        }
    </div>
</div>