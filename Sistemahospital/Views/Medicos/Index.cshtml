@model List<Sistemahospital.Models.Medico>
@{
    ViewBag.Title = "Medicos";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4><i class="fas fa-user-md"></i> Gestion de Medicos</h4>
        <small>Listado de medicos registrados</small>
    </div>
    <a href="@Url.Action("Crear")" class="btn btn-sm" style="background-color:#003876; color:white;">
        <i class="fas fa-plus"></i> Nuevo Medico
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Especialidad</th>
                    <th>Telefono</th>
                    <th>Email</th>
                    <th>Hospital</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.IDMedico</td>
                        <td>@m.Nombre</td>
                        <td>@m.Apellido</td>
                        <td>@m.Especialidad</td>
                        <td>@m.Telefono</td>
                        <td>@m.Email</td>
                        <td>@m.NombreHospital</td>
                        <td>
                            <a href="@Url.Action("Editar", new { id = m.IDMedico })" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                            @using (Html.BeginForm("Eliminar", "Medicos", new { id = m.IDMedico }, FormMethod.Post, new { style = "display:inline;" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Desea eliminar este medico?')"><i class="fas fa-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>