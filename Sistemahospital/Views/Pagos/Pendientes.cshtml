@model List<Sistemahospital.Models.Pago>
@{
    ViewBag.Title = "Pagos Pendientes";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4><i class="fas fa-clock"></i> Pagos Pendientes</h4>
        <small>Pagos que aun no han sido saldados</small>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary">
        <i class="fas fa-list"></i> Ver Todos
    </a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Paciente</th>
                    <th>Tratamiento</th>
                    <th>Hospital</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Registrar Pago</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.IDPago</td>
                        <td>@p.NombrePaciente</td>
                        <td>@p.DescripcionTratamiento</td>
                        <td>@p.NombreHospital</td>
                        <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>₡@p.Monto.ToString("N2")</td>
                        <td>
                            @using (Html.BeginForm("Pagar", "Pagos", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                <input type="hidden" name="idPago" value="@p.IDPago" />
                                <select name="metodoPago" class="form-select form-select-sm d-inline w-auto">
                                    <option value="Efectivo">Efectivo</option>
                                    <option value="Tarjeta">Tarjeta</option>
                                    <option value="Transferencia">Transferencia</option>
                                </select>
                                <button type="submit" class="btn btn-success btn-sm ms-1"
                                        onclick="return confirm('Confirmar pago?')">
                                    <i class="fas fa-check"></i> Pagar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>