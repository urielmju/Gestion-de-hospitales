@model List<Sistemahospital.Models.Pago>
@{
    ViewBag.Title = "Pagos";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4><i class="fas fa-file-invoice-dollar"></i> Historial de Pagos</h4>
        <small>Todos los pagos registrados</small>
    </div>
    @{
        int rolPagos = Session["IDRol"] != null ? Convert.ToInt32(Session["IDRol"].ToString()) : 0;
    }
    @if (rolPagos == 3 || rolPagos == 4)
    {
        <a href="@Url.Action("Pendientes")" class="btn btn-sm btn-warning">
            <i class="fas fa-clock"></i> Ver Pendientes
        </a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Paciente</th>
                    <th>Tratamiento</th>
                    <th>Hospital</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Metodo</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.IDPago</td>
                        <td>@p.NombrePaciente</td>
                        <td>@p.DescripcionTratamiento</td>
                        <td>@p.NombreHospital</td>
                        <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>₡@p.Monto.ToString("N2")</td>
                        <td>@p.MetodoPago</td>
                        <td>
                            @if (p.Estado == "PA")
                            {
                                <span class="badge bg-success">Pagado</span>
                            }
                            else if (p.Estado == "P")
                            {
                                <span class="badge bg-warning text-dark">Pendiente</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Cancelado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>