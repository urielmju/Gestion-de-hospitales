<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google-site-verification" content="8TEmZyR4J2PyS9SwpEoB12T8C6sTNI8DtPT0JTGfT24" />
    <title>Sistema de Hospitales</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
        }

        .topbar {
            background-color: #003876;
            color: white;
            padding: 8px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            height: 50px;
        }

            .topbar .logo {
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .topbar .logo span {
                    font-size: 15px;
                    font-weight: bold;
                }

                .topbar .logo small {
                    display: block;
                    font-size: 11px;
                    color: #adc8f0;
                }

            .topbar .user-info {
                font-size: 13px;
                display: flex;
                align-items: center;
                gap: 15px;
            }

                .topbar .user-info a {
                    color: #adc8f0;
                    text-decoration: none;
                    font-size: 12px;
                }

                    .topbar .user-info a:hover {
                        color: white;
                    }

        .subbar {
            background-color: #0057a8;
            padding: 0 20px;
            display: flex;
            gap: 2px;
            position: fixed;
            top: 50px;
            left: 0;
            right: 0;
            z-index: 999;
            height: 40px;
            align-items: center;
        }

            .subbar a {
                color: #d0e4f7;
                text-decoration: none;
                padding: 6px 12px;
                font-size: 13px;
                border-radius: 4px;
                white-space: nowrap;
            }

                .subbar a:hover {
                    background-color: #003876;
                    color: white;
                }

        .sidebar {
            width: 210px;
            min-height: 100vh;
            background-color: #ffffff;
            border-right: 1px solid #d0d9e8;
            padding-top: 10px;
            position: fixed;
            top: 90px;
            left: 0;
            bottom: 0;
            overflow-y: auto;
            z-index: 998;
        }

            .sidebar .menu-section {
                padding: 8px 15px 4px 15px;
                font-size: 10px;
                color: #999;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-top: 8px;
            }

            .sidebar a {
                display: block;
                padding: 8px 18px;
                font-size: 13px;
                color: #333;
                text-decoration: none;
                border-left: 3px solid transparent;
                white-space: nowrap;
            }

                .sidebar a:hover {
                    background-color: #e8f0fb;
                    border-left: 3px solid #0057a8;
                    color: #0057a8;
                }

                .sidebar a i {
                    width: 18px;
                    margin-right: 6px;
                }

        .main-content {
            margin-left: 210px;
            margin-top: 90px;
            padding: 20px;
            min-height: calc(100vh - 90px);
            width: calc(100% - 210px);
        }

        .stat-card {
            border-radius: 8px;
            padding: 15px;
            color: white;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

            .stat-card i {
                font-size: 32px;
                opacity: 0.8;
            }

            .stat-card .stat-info h3 {
                margin: 0;
                font-size: 26px;
                font-weight: bold;
            }

            .stat-card .stat-info p {
                margin: 0;
                font-size: 12px;
                opacity: 0.9;
            }

        .bg-azul {
            background-color: #0057a8;
        }

        .bg-verde {
            background-color: #1a7a4a;
        }

        .bg-naranja {
            background-color: #c85a00;
        }

        .bg-rojo {
            background-color: #9b1b1b;
        }

        .table thead th {
            background-color: #003876;
            color: white;
            font-size: 13px;
            font-weight: normal;
        }

        .table tbody tr:hover {
            background-color: #f0f6ff;
        }

        .table td {
            font-size: 13px;
            vertical-align: middle;
        }

        .page-header {
            border-bottom: 2px solid #0057a8;
            margin-bottom: 20px;
            padding-bottom: 8px;
        }

            .page-header h4 {
                color: #003876;
                margin: 0;
                font-size: 18px;
            }

            .page-header small {
                color: #666;
                font-size: 12px;
            }
    </style>
</head>
<body>

    <!-- barra superior -->
    <div class="topbar">
        <div class="logo">
            <i class="fas fa-hospital fa-lg"></i>
            <span>
                Sistema de Gestion de Hospitales
                <small>Proyecto de portafolio academico</small>
            </span>
        </div>
        <div class="user-info">
            <span><i class="fas fa-user-circle"></i> @Session["Username"] | @Session["NombreRol"]</span>
            <a href="@Url.Action("Logout", "Account")"><i class="fas fa-sign-out-alt"></i> Cerrar Sesion</a>
        </div>
    </div>

    <!-- barra secundaria -->
    <div class="subbar">
        @{
            int rolBar = Session["IDRol"] != null ? Convert.ToInt32(Session["IDRol"].ToString()) : 0;
        }
        @if (rolBar == 1)
        {
            <a href="@Url.Action("MiHistorial", "Pacientes")"><i class="fas fa-file-medical"></i> Mi Historial</a>
            <a href="@Url.Action("Index", "Pagos")"><i class="fas fa-dollar-sign"></i> Mis Pagos</a>
        }
        @if (rolBar == 2)
        {
            <a href="@Url.Action("MisCitas", "Atencion")"><i class="fas fa-stethoscope"></i> Mis Citas</a>
        }
        @if (rolBar == 3)
        {
            <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Inicio</a>
            <a href="@Url.Action("Index", "Pacientes")"><i class="fas fa-users"></i> Pacientes</a>
            <a href="@Url.Action("Index", "Citas")"><i class="fas fa-calendar-alt"></i> Citas</a>
            <a href="@Url.Action("Pendientes", "Pagos")"><i class="fas fa-dollar-sign"></i> Cobrar Pagos</a>
            <a href="@Url.Action("Index", "Pagos")"><i class="fas fa-list"></i> Historial Pagos</a>
        }
        @if (rolBar == 4)
        {
            <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Inicio</a>
            <a href="@Url.Action("Index", "Pacientes")"><i class="fas fa-users"></i> Pacientes</a>
            <a href="@Url.Action("Index", "Medicos")"><i class="fas fa-user-md"></i> Medicos</a>
            <a href="@Url.Action("Index", "Citas")"><i class="fas fa-calendar-alt"></i> Citas</a>
            <a href="@Url.Action("Pendientes", "Pagos")"><i class="fas fa-dollar-sign"></i> Pagos</a>
            <a href="@Url.Action("Index", "Medicamentos")"><i class="fas fa-pills"></i> Medicamentos</a>
            <a href="@Url.Action("Index", "Reportes")"><i class="fas fa-chart-bar"></i> Reportes</a>
        }
        @if (rolBar == 5)
        {
            <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Inicio</a>
            <a href="@Url.Action("Index", "Pacientes")"><i class="fas fa-users"></i> Pacientes</a>
            <a href="@Url.Action("Index", "Citas")"><i class="fas fa-calendar-alt"></i> Citas</a>
            <a href="@Url.Action("Pendientes", "Pagos")"><i class="fas fa-dollar-sign"></i> Cobrar</a>
        }
        @if (rolBar == 6)
        {
            <a href="@Url.Action("Index", "Medicamentos")"><i class="fas fa-pills"></i> Medicamentos</a>
            <a href="@Url.Action("StockBajo", "Reportes")"><i class="fas fa-exclamation-triangle"></i> Stock Bajo</a>
        }
    </div>

    <!-- sidebar -->
    <div class="sidebar">
        @{
            int rol = Session["IDRol"] != null ? Convert.ToInt32(Session["IDRol"].ToString()) : 0;
        }

        @if (rol == 1)
        {
            <div class="menu-section">Mi Cuenta</div>
            <a href="@Url.Action("MiHistorial", "Pacientes")"><i class="fas fa-file-medical"></i> Mi Historial</a>
            <a href="@Url.Action("Index", "Pagos")"><i class="fas fa-file-invoice-dollar"></i> Mis Pagos</a>
        }

        @if (rol == 2)
        {
            <div class="menu-section">Atencion</div>
            <a href="@Url.Action("MisCitas", "Atencion")"><i class="fas fa-stethoscope"></i> Mis Citas</a>
        }

        @if (rol == 3)
        {
            <div class="menu-section">Dashboard</div>
            <a href="@Url.Action("Index", "Home")"><i class="fas fa-tachometer-alt"></i> Dashboard</a>

            <div class="menu-section">Gestion</div>
            <a href="@Url.Action("Index", "Pacientes")"><i class="fas fa-user-injured"></i> Pacientes</a>
            <a href="@Url.Action("Index", "Citas")"><i class="fas fa-calendar-check"></i> Citas</a>

            <div class="menu-section">Administrativo</div>
            <a href="@Url.Action("Pendientes", "Pagos")"><i class="fas fa-file-invoice-dollar"></i> Cobrar Pagos</a>
            <a href="@Url.Action("Index", "Pagos")"><i class="fas fa-list"></i> Historial Pagos</a>
        }

        @if (rol == 4)
        {
            <div class="menu-section">Dashboard</div>
            <a href="@Url.Action("Index", "Home")"><i class="fas fa-tachometer-alt"></i> Dashboard</a>

            <div class="menu-section">Gestion</div>
            <a href="@Url.Action("Index", "Pacientes")"><i class="fas fa-user-injured"></i> Pacientes</a>
            <a href="@Url.Action("Index", "Medicos")"><i class="fas fa-user-md"></i> Medicos</a>
            <a href="@Url.Action("Index", "Citas")"><i class="fas fa-calendar-check"></i> Citas</a>
            <a href="@Url.Action("MisCitas", "Atencion")"><i class="fas fa-stethoscope"></i> Atender Paciente</a>

            <div class="menu-section">Administrativo</div>
            <a href="@Url.Action("Pendientes", "Pagos")"><i class="fas fa-file-invoice-dollar"></i> Cobrar Pagos</a>
            <a href="@Url.Action("Index", "Pagos")"><i class="fas fa-list"></i> Historial Pagos</a>
            <a href="@Url.Action("Index", "Medicamentos")"><i class="fas fa-pills"></i> Medicamentos</a>

            <div class="menu-section">Reportes</div>
            <a href="@Url.Action("Index", "Reportes")"><i class="fas fa-chart-line"></i> Reportes</a>
            <a href="@Url.Action("StockBajo", "Reportes")"><i class="fas fa-exclamation-triangle"></i> Stock Bajo</a>
            <a href="@Url.Action("HistorialMedico", "Reportes")"><i class="fas fa-file-medical"></i> Historial Medico</a>
        }

        @if (rol == 5)
        {
            <div class="menu-section">Dashboard</div>
            <a href="@Url.Action("Index", "Home")"><i class="fas fa-tachometer-alt"></i> Dashboard</a>

            <div class="menu-section">Recepcion</div>
            <a href="@Url.Action("Index", "Pacientes")"><i class="fas fa-user-injured"></i> Pacientes</a>
            <a href="@Url.Action("Crear", "Pacientes")"><i class="fas fa-user-plus"></i> Ingresar Paciente</a>
            <a href="@Url.Action("Index", "Citas")"><i class="fas fa-calendar-check"></i> Citas</a>
            <a href="@Url.Action("Crear", "Citas")"><i class="fas fa-calendar-plus"></i> Asignar Cita</a>

            <div class="menu-section">Cobros</div>
            <a href="@Url.Action("Pendientes", "Pagos")"><i class="fas fa-file-invoice-dollar"></i> Cobrar Pagos</a>
            <a href="@Url.Action("Index", "Pagos")"><i class="fas fa-list"></i> Historial Pagos</a>
        }

        @if (rol == 6)
        {
            <div class="menu-section">Farmacia</div>
            <a href="@Url.Action("Index", "Medicamentos")"><i class="fas fa-pills"></i> Medicamentos</a>
            <a href="@Url.Action("StockBajo", "Reportes")"><i class="fas fa-exclamation-triangle"></i> Stock Bajo</a>
        }
    </div>

    <!-- contenido principal -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>