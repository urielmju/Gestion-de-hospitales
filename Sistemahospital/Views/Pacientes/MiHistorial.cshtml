@{
    ViewBag.Title = "Mi Historial";
    var paciente = ViewBag.Paciente as Sistemahospital.Models.Paciente;
}

<div class="page-header">
    <h4><i class="fas fa-file-medical"></i> Mi Historial Medico</h4>
</div>

@if (paciente != null)
{
    <div class="card mb-3">
        <div class="card-header" style="background-color:#003876; color:white; font-size:13px;">
            <i class="fas fa-user"></i> Mis Datos
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <small class="text-muted">Nombre</small>
                    <p><strong>@paciente.Nombre @paciente.Apellido</strong></p>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Hospital</small>
                    <p>@paciente.NombreHospital</p>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Telefono</small>
                    <p>@paciente.Telefono</p>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Email</small>
                    <p>@paciente.Email</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <a href="@Url.Action("HistorialMedico", "Reportes", new { idPaciente = ViewBag.IDPaciente })"
               class="card text-decoration-none" style="display:block;">
                <div class="card-body text-center py-4">
                    <i class="fas fa-notes-medical fa-3x mb-3" style="color:#003876;"></i>
                    <h5 style="color:#003876;">Ver Historial de Citas</h5>
                    <p class="text-muted mb-0">Diagnosticos y tratamientos</p>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a href="@Url.Action("Index", "Pagos")"
               class="card text-decoration-none" style="display:block;">
                <div class="card-body text-center py-4">
                    <i class="fas fa-file-invoice-dollar fa-3x mb-3" style="color:#1a7a4a;"></i>
                    <h5 style="color:#1a7a4a;">Ver Mis Pagos</h5>
                    <p class="text-muted mb-0">Historial de pagos y pendientes</p>
                </div>
            </a>
        </div>
    </div>
}