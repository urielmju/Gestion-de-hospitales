@model List<Sistemahospital.Models.Paciente>
@{
    ViewBag.Title = "Pacientes";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4><i class="fas fa-user-injured"></i> Gestion de Pacientes</h4>
        <small>Listado de pacientes registrados</small>
    </div>
    <a href="@Url.Action("Crear")" class="btn btn-sm" style="background-color:#003876; color:white;">
        <i class="fas fa-plus"></i> Nuevo Paciente
    </a>
</div>

<!-- busqueda -->
<div class="card mb-3">
    <div class="card-body py-2">
        @using (Html.BeginForm("Index", "Pacientes", FormMethod.Get))
        {
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label mb-1" style="font-size:12px;">Nombre</label>
                    <input type="text" name="nombre" value="@ViewBag.Nombre" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label class="form-label mb-1" style="font-size:12px;">Apellido</label>
                    <input type="text" name="apellido" value="@ViewBag.Apellido" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i> Buscar</button>
                    <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary">Limpiar</a>
                </div>
            </div>
        }
    </div>
</div>

<!-- tabla -->
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Telefono</th>
                    <th>Email</th>
                    <th>Hospital</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.IDPaciente</td>
                        <td>@p.Nombre</td>
                        <td>@p.Apellido</td>
                        <td>@p.Telefono</td>
                        <td>@p.Email</td>
                        <td>@p.NombreHospital</td>
                        <td>
                            <a href="@Url.Action("Editar", new { id = p.IDPaciente })" class="btn btn-xs btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                            <a href="@Url.Action("Historial", new { id = p.IDPaciente })" class="btn btn-xs btn-info btn-sm"><i class="fas fa-file-medical"></i></a>
                            @using (Html.BeginForm("Eliminar", "Pacientes", new { id = p.IDPaciente }, FormMethod.Post, new { style = "display:inline;" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-xs btn-danger btn-sm" onclick="return confirm('Desea eliminar este paciente?')"><i class="fas fa-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>